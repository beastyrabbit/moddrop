{
  "name": "stream-canvas",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "portless moddrop-stream-canvas node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit src/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "db:migrate:compiled": "node dist/migrate.js",
    "import:legacy:compiled": "node dist/import-legacy-sqlite.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.13.1",
    "@hono/node-server": "^2.0.11",
    "@tldraw/sync-core": "^5.2.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "minio": "8.0.7",
    "pg": "^8.22.0",
    "tldraw": "^5.2.5",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "^0.31.10",
    "pg-mem": "^3.0.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": "26.5.x",
    "pnpm": "11.17.x"
  }
}
